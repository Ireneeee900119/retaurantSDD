{
  "uid": "restaurantsdd-overview",
  "title": "restaurantSDD Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "HTTP Requests / sec",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 5 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(restaurant_http_requests_total[1m]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "5xx Errors / sec",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 5 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(restaurant_http_requests_total{status_code=~\"5..\"}[1m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 Latency",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 7 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(restaurant_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Backend Logs",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 7 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{service=\"backend\"}"
        }
      ]
    }
  ]
}
